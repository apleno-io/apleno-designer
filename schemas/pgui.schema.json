{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apleno interface file (.pgui)",
  "description": "A user interface (a form) shown to the end user during one 'gui' step of a sequence. The file is JSON, edited visually by the Apleno Interface Editor. It contains a tree of widgets; container widgets (box, columns, tabs) hold child widgets.",
  "type": "object",
  "required": [
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "language": {
      "description": "Language used by every code property of this interface (widget values with 'isr: true', onchange, condition, onpress, intervalcode, ...).",
      "enum": [
        "r",
        "python"
      ],
      "default": "r"
    },
    "submitbutton": {
      "description": "Show the 'Submit' button at the bottom of the interface. Submitting validates the widgets and moves the sequence to the next step.",
      "type": "boolean",
      "default": true
    },
    "elements": {
      "description": "Top-level widgets, displayed from top to bottom.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/widget"
      }
    }
  },
  "definitions": {
    "widget": {
      "description": "A widget. 'data' holds the widget properties; the allowed properties depend on 'type'.",
      "type": "object",
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifier of the widget, used from R/Python code: the widget value is a variable with this name, and GUI functions use it (gui.setValue('this', 'age', 42)). Must be a valid variable name, unique in the file, and not an R/Python built-in name. Empty string for widgets never used from code.",
          "type": "string"
        },
        "type": {
          "description": "Widget type. Display: label, image, iframe, table, graph, progress. Data input: text, number, path, select, onoff, date, grid. Actions: button, interval. Layout containers: box, columns, tabs.",
          "enum": [
            "label",
            "image",
            "iframe",
            "table",
            "text",
            "number",
            "path",
            "select",
            "onoff",
            "date",
            "grid",
            "button",
            "box",
            "columns",
            "tabs",
            "graph",
            "progress",
            "interval"
          ]
        },
        "data": {
          "description": "Widget properties. See the definition matching the widget type.",
          "type": "object"
        },
        "elements": {
          "description": "Child widgets. Only allowed for container widgets (box, columns, tabs).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/widget"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "label"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-label"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-image"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "iframe"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-iframe"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-table"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-text"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "path"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-path"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-select"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "onoff"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-onoff"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "date"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grid"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-grid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-button"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graph"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-graph"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "progress"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-progress"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interval"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/definitions/data-interval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "box"
              }
            }
          },
          "then": {
            "required": [
              "elements"
            ],
            "properties": {
              "data": {
                "$ref": "#/definitions/data-box"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            }
          },
          "then": {
            "description": "A columns widget must have exactly one child per entry of data.columnswidths, and each child must be a 'box' widget holding that column's widgets.",
            "required": [
              "elements"
            ],
            "properties": {
              "data": {
                "$ref": "#/definitions/data-columns"
              },
              "elements": {
                "items": {
                  "$ref": "#/definitions/container-slot"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tabs"
              }
            }
          },
          "then": {
            "description": "A tabs widget must have exactly one child per entry of data.tabsnames, and each child must be a 'box' widget holding that tab's widgets.",
            "required": [
              "elements"
            ],
            "properties": {
              "data": {
                "$ref": "#/definitions/data-tabs"
              },
              "elements": {
                "items": {
                  "$ref": "#/definitions/container-slot"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "box",
                  "columns",
                  "tabs"
                ]
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "elements"
              ]
            }
          }
        }
      ]
    },
    "container-slot": {
      "description": "One column of a 'columns' widget or one tab of a 'tabs' widget: a 'box' widget, usually with data { \"labelposition\": \"hidden\", \"margintop\": 0, \"boxdesign\": \"none\", \"boxheader\": \"\" }.",
      "type": "object",
      "properties": {
        "type": {
          "const": "box"
        }
      }
    },
    "prop-value": {
      "description": "The value of the widget. If 'isr' is true, this is R/Python code evaluated to get the value; otherwise it is the literal value.",
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "null"
      ],
      "default": ""
    },
    "prop-language": {
      "description": "If true, 'value' is an R/Python expression (in the interface language) evaluated at runtime; if false, 'value' is a literal value.",
      "type": "boolean",
      "default": false
    },
    "prop-css": {
      "description": "Custom styling. If the text contains ':' it is used as inline CSS declarations (e.g. \"color: red; font-weight: bold\"); otherwise it is a space-separated list of CSS class names.",
      "type": "string",
      "default": ""
    },
    "prop-marginTop": {
      "description": "Space above the widget, in pixels.",
      "type": [
        "integer",
        "null",
        "string"
      ],
      "minimum": 0,
      "default": 10
    },
    "prop-labelText": {
      "description": "Text of the label displayed next to the widget. HTML is allowed.",
      "type": "string",
      "default": ""
    },
    "prop-labelPosition": {
      "description": "Label placement: 'left' (label in a left column), 'top' (above the widget), 'topaligned' (above the widget, aligned with left-labelled widgets), 'hidden' (no label, widget uses the full width).",
      "enum": [
        "left",
        "top",
        "topaligned",
        "hidden"
      ],
      "default": "left"
    },
    "prop-helpText": {
      "description": "Help text for the widget. HTML is allowed.",
      "type": "string",
      "default": ""
    },
    "prop-helpPosition": {
      "description": "Help text placement: 'bottom' (below the widget) or 'label' (as an info icon tooltip next to the label).",
      "enum": [
        "bottom",
        "label"
      ],
      "default": "bottom"
    },
    "prop-isRequired": {
      "description": "If true, the user must fill a value before the interface can be submitted. The label gets a '*'.",
      "type": "boolean",
      "default": false
    },
    "prop-codeOnChange": {
      "description": "R/Python code (in the interface language) executed every time the user changes the widget value. Empty string for none.",
      "type": "string",
      "default": ""
    },
    "prop-conditionOnSubmit": {
      "description": "R/Python expression (in the interface language) evaluated when the interface is submitted; it must return TRUE/True for the submission to be accepted. Empty string for no validation.",
      "type": "string",
      "default": ""
    },
    "data-label": {
      "description": "Displays a text. 'value' is the text; HTML is allowed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        },
        "fontsize": {
          "description": "Font size in pixels.",
          "type": [
            "number",
            "string",
            "null"
          ],
          "default": 14
        },
        "fontfamily": {
          "description": "Font family.",
          "enum": [
            "default",
            "arial",
            "courier",
            "georgia",
            "impact",
            "times",
            "trebuchet",
            "verdana"
          ],
          "default": "default"
        },
        "fontcolor": {
          "description": "Text color, as a hex color like '#000000'.",
          "type": "string",
          "default": "#000000"
        }
      }
    },
    "data-image": {
      "description": "Displays an image. 'value' is the image path or URL.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        }
      }
    },
    "data-iframe": {
      "description": "Displays an embedded web page. 'value' is the page path or URL.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        }
      }
    },
    "data-table": {
      "description": "Displays a read-only table. 'value' is usually an R/Python expression (with isr: true) returning a data frame.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        }
      }
    },
    "data-text": {
      "description": "Text input. 'value' is the initial text.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtype": {
          "description": "'text' (single line), 'textarea' (multi-line) or 'password' (hidden characters).",
          "enum": [
            "text",
            "textarea",
            "password"
          ],
          "default": "text"
        },
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        },
        "required": {
          "$ref": "#/definitions/prop-isRequired"
        },
        "onchange": {
          "$ref": "#/definitions/prop-codeOnChange"
        },
        "condition": {
          "$ref": "#/definitions/prop-conditionOnSubmit"
        }
      }
    },
    "data-number": {
      "description": "Number input. 'value' is the initial number.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtype": {
          "description": "'float' (decimal number), 'integer' or 'slider' (range slider; set min and max).",
          "enum": [
            "float",
            "integer",
            "slider"
          ],
          "default": "float"
        },
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        },
        "required": {
          "$ref": "#/definitions/prop-isRequired"
        },
        "onchange": {
          "$ref": "#/definitions/prop-codeOnChange"
        },
        "condition": {
          "$ref": "#/definitions/prop-conditionOnSubmit"
        },
        "min": {
          "description": "Minimum value. Empty string or null for no minimum.",
          "type": [
            "number",
            "string",
            "null"
          ],
          "default": ""
        },
        "max": {
          "description": "Maximum value. Empty string or null for no maximum.",
          "type": [
            "number",
            "string",
            "null"
          ],
          "default": ""
        },
        "step": {
          "description": "Increment step. Empty string or null for any step.",
          "type": [
            "number",
            "string",
            "null"
          ],
          "default": ""
        }
      }
    },
    "data-path": {
      "description": "File chooser input: a text field with a 'Browse...' button. 'value' is the initial path.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtype": {
          "description": "Only 'file' is supported.",
          "enum": [
            "file"
          ],
          "default": "file"
        },
        "value": {
          "$ref": "#/definitions/prop-value"
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        },
        "required": {
          "$ref": "#/definitions/prop-isRequired"
        },
        "onchange": {
          "$ref": "#/definitions/prop-codeOnChange"
        },
        "condition": {
          "$ref": "#/definitions/prop-conditionOnSubmit"
        }
      }
    },
    "data-select": {
      "description": "Choice input. Options come from 'choices' (static) or from 'choicesvalues' / 'choicestexts' (R/Python variables).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtype": {
          "description": "'select' (dropdown, one choice), 'multiselect' (list, several choices), 'radio' (radio buttons, one choice), 'multicheckboxes' (checkboxes, several choices).",
          "enum": [
            "select",
            "multiselect",
            "radio",
            "multicheckboxes"
          ],
          "default": "select"
        },
        "value": {
          "description": "Selected option value(s): a string for 'select' and 'radio'; an array of strings (or a comma-separated string) for 'multiselect' and 'multicheckboxes'. If 'isr' is true, R/Python code returning the selection.",
          "type": [
            "string",
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": ""
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
        "helpposition": {
          "$ref": "#/definitions/prop-helpPosition"
        },
        "required": {
          "$ref": "#/definitions/prop-isRequired"
        },
        "onchange": {
          "$ref": "#/definitions/prop-codeOnChange"
        },
        "condition": {
          "$ref": "#/definitions/prop-conditionOnSubmit"
        },
        "choices": {
          "description": "Static list of options.",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "value",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "description": "Value returned when this option is selected.",
                "type": "string"
              },
              "text": {
                "description": "Text displayed to the user.",
                "type": "string"
              }
            }
          }
        },
        "choicesvalues": {
          "description": "Name of an R/Python variable (vector/list) providing the option values. Empty string to use choices.",
          "type": "string",
          "default": ""
        },
        "choicestexts": {
          "description": "Name of an R/Python variable (vector/list) providing the option texts, in the same order as choicesvalues.",
          "type": "string",
          "default": ""
        }
      }
    },
    "data-onoff": {
      "description": "Boolean input. 'value' is true (checked) or false.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtype": {
          "description": "'checkbox' (standard checkbox) or 'switch' (mobile-like toggle).",
          "enum": [
            "checkbox",
            "switch"
          ],
          "default": "checkbox"
        },
        "value": {
          "description": "true (on) or false (off). If 'isr' is true, R/Python code returning a boolean.",
          "type": [
            "boolean",
            "string"
          ],
          "default": false
        },
        "isr": {
          "$ref": "#/definitions/prop-language"
        },
        "css": {
          "$ref": "#/definitions/prop-css"
        },
        "margintop": {
          "$ref": "#/definitions/prop-marginTop"
        },
        "labeltext": {
          "$ref": "#/definitions/prop-labelText"
        },
        "labelposition": {
          "$ref": "#/definitions/prop-labelPosition"
        },
        "helptext": {
          "$ref": "#/definitions/prop-helpText"
        },
