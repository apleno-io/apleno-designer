{
  "name": "apleno-designer",
  "version": "1.0.1",
  "publisher": "apleno",
  "author": {
    "name": "Apleno"
  },
  "displayName": "Apleno Designer",
  "description": "Create amazing apps with user-friendly UI.",
  "icon": "icons/app.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apleno-io/apleno-designer.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Data Science",
    "Extension Packs"
  ],
  "activationEvents": [
    "onDebugResolve:apleno"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "apleno.ppro",
        "displayName": "Apleno Project Editor",
        "selector": [
          {
            "filenamePattern": "*.ppro"
          }
        ]
      },
      {
        "viewType": "apleno.pseq",
        "displayName": "Apleno Sequence Editor",
        "selector": [
          {
            "filenamePattern": "*.pseq"
          }
        ]
      },
      {
        "viewType": "apleno.pgui",
        "displayName": "Apleno Interface Editor",
        "selector": [
          {
            "filenamePattern": "*.pgui"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "apleno.export",
        "title": "Apleno: Export app"
      },
      {
        "command": "apleno.initialize",
        "title": "Apleno: Create new project"
      },
      {
        "command": "apleno.language.choose.r",
        "title": "Apleno: Choose R path for preview"
      },
      {
        "command": "apleno.language.choose.python",
        "title": "Apleno: Choose Python path for preview"
      },
      {
        "command": "apleno.language.choose.conda",
        "title": "Apleno: Choose Conda path for preview"
      },
      {
        "command": "apleno.ppro.new",
        "title": "Apleno: Create new Project file"
      },
      {
        "command": "apleno.pseq.new",
        "title": "Apleno: Create new Sequence file"
      },
      {
        "command": "apleno.pgui.new",
        "title": "Apleno: Create new Interface file"
      },
      {
        "command": "apleno.logs",
        "title": "Apleno: Show logs"
      }
    ],
    "debuggers": [
      {
        "type": "apleno",
        "label": "Apleno",
        "languages": [],
        "program": "./dist/debug-adapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "request": {
                "type": "string"
              },
              "debugExePath": {
                "type": "string",
                "description": "Absolute path to debugger"
              },
              "debugConfigPath": {
                "type": "string",
                "description": "Absolute path to debugger config"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "apleno",
            "request": "launch",
            "name": "Apleno preview"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "ppro",
        "extensions": [
          ".ppro"
        ],
        "icon": {
          "light": "./icons/ppro.svg",
          "dark": "./icons/ppro.svg"
        }
      },
      {
        "id": "pseq",
        "extensions": [
          ".pseq"
        ],
        "icon": {
          "light": "./icons/pseq.svg",
          "dark": "./icons/pseq.svg"
        }
      },
      {
        "id": "pgui",
        "extensions": [
          ".pgui"
        ],
        "icon": {
          "light": "./icons/pgui.svg",
          "dark": "./icons/pgui.svg"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project src/extension/tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit --project src/extension/tsconfig.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/micromatch": "^4.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.19.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "adm-zip": "^0.5.16",
    "micromatch": "^4.0.8",
    "semver": "^7.7.3"
  }
}
