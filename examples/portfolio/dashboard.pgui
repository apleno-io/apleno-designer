										"css": "",
										"margintop": "10",
										"labeltext": "\\(\\sigma^2\\)",
										"labelposition": "top",
										"helptext": "Variance moyenne",
										"helpposition": "label",
										"required": false,
										"onchange": "",
										"condition": "",
										"min": "",
