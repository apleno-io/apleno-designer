						{
							"id": "",
							"type": "label",
							"data": {
								"value": "\\(\\sup_{α} \\mathbb{E}[U(X_{T}^{\\alpha}) | X_{t}^{\\alpha} = x]\\)",
								"css": "font-weight: bold;",
								"isr": false,
								"margintop": 10,
								"labeltext": "Objectif :",
								"labelposition": "top",
								"helptext": "\\(U(x) = -\\exp(-\\eta x)\\), fonction d'utilité concave avec aversion au risque \\(\\eta\\).",
