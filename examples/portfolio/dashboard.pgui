								"css": "",
								"subType": "float",
								"language": false,
								"isRequired": false,
								"codeOnChange": "",
								"conditionOnSubmit": "",
								"marginTop": 10,
								"labelText": "Performance action (μ) :",
								"labelPosition": "top",
								"helpText": "",
								"helpPosition": "bottom",
								"numberMinValue": "",
								"numberMaxValue": "",
								"numberStepChange": "0.01"
