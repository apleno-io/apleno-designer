										"css": "",
										"margintop": "10",
										"labeltext": "\\(\\beta\\)",
										"labelposition": "top",
										"helptext": "Vitesse retour à la moyenne ",
										"helpposition": "label",
										"required": false,
										"onchange": "",
										"condition": "",
										"min": "",
										"max": "",
										"step": "0.1"
									}
								},
								{
									"id": "s2",
