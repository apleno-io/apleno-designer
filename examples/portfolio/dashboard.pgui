										"labeltext": "\\(\\xi\\)",
										"labelposition": "top",
										"helptext": "Variance de la variance",
										"helpposition": "label",
										"required": false,
										"onchange": "",
										"condition": "",
										"min": "",
										"max": "",
										"step": "0.01"
