								"isr": false,
								"required": false,
								"onchange": "",
								"condition": "",
								"margintop": 10,
								"labeltext": "Performance action (μ) :",
								"labelposition": "top",
								"helptext": "",
								"helpposition": "bottom",
								"min": "",
								"max": "",
								"step": "0.01"
							}
						},
						{
							"id": "",
							"type": "label",
							"data": {
								"value": "\\(dV_s = -\\beta(V_s-\\sigma^2)ds + \\xi\\sqrt{V_s}dB_s\\)",
