							"type": "number",
							"data": {
								"subtype": "float",
								"value": "0.1",
								"isr": false,
								"css": "",
								"margintop": "10",
								"labeltext": "Aversion au risque (\\(\\eta\\) ) :",
								"labelposition": "top",
								"helptext": "",
								"helpposition": "bottom",
								"required": false,
								"onchange": "",
								"condition": "eta > 0",
								"min": "",
								"max": "",
								"step": ""
							}
						}
					]
				},
				{
					"id": "",
					"type": "box",
					"data": {
						"css": "ocbox bluebox",
