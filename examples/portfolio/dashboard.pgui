						{
							"id": "",
							"type": "label",
							"data": {
								"value": "Processus",
								"isr": false,
								"css": "ch4",
								"margintop": "0",
								"labeltext": "",
								"labelposition": "hidden",
								"helptext": "",
								"helpposition": "bottom",
								"fontsize": "14",
								"fontfamily": "default",
								"fontcolor": "#000000"
							}
						},
						{
							"id": "",
							"type": "label",
							"data": {
								"value": "\\(dX_{t}^{\\alpha} = \\alpha_{t}\\mu dt + \\alpha_{s}\\sqrt{V_s}dW_s\\)",
								"isr": false,
								"css": "font-weight: bold;",
								"margintop": "10",
								"labeltext": "Processus de richesse :",
								"labelposition": "top",
								"helptext": "\\(X^{\\alpha}\\) est la richesse en €, \\(\\alpha_s\\) est la quantité en € investie, \\(W\\) est un mouvement brownien.",
								"helpposition": "bottom",
								"fontsize": "16",
								"fontfamily": "default",
								"fontcolor": "#000000"
							}
						},
						{
							"id": "mu",
							"type": "number",
							"data": {
								"subtype": "float",
								"value": "0.07",
								"isr": false,
								"css": "",
								"margintop": "10",
								"labeltext": "Performance action (μ) :",
								"labelposition": "top",
								"helptext": "",
								"helpposition": "bottom",
								"required": false,
								"onchange": "",
								"condition": "",
								"min": "",
								"max": "",
								"step": "0.01"
							}
						},
						{
							"id": "",
							"type": "label",
							"data": {
								"value": "\\(dV_s = -\\beta(V_s-\\sigma^2)ds + \\xi\\sqrt{V_s}dB_s\\)",
								"isr": false,
								"css": "font-weight: bold;",
								"margintop": "10",
								"labeltext": "Processus de variance :",
								"labelposition": "top",
								"helptext": "\\(V_s\\) suit un processus CIR et \\(\\sqrt{V_s}\\) est la volatilité instantanée, \\(B\\) est un mouvement brownien avec \\(cor(B, W) = \\rho\\)",
								"helpposition": "bottom",
								"fontsize": "18",
								"fontfamily": "default",
								"fontcolor": "#000000"
							}
						},
						{
							"id": "",
							"type": "columns",
							"data": {
								"css": "",
								"margintop": "10",
								"labeltext": "",
