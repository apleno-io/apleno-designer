							"id": 8,
							"customId": "",
							"type": "label",
							"data": {
								"value": "\\(\\sup_{α} \\mathbb{E}[U(X_{T}^{\\alpha}) | X_{t}^{\\alpha} = x]\\)",
								"css": "font-weight: bold;",
								"language": false,
								"marginTop": 10,
								"labelText": "Objectif :",
								"labelPosition": "top",
								"helpText": "\\(U(x) = -\\exp(-\\eta x)\\), fonction d'utilité concave avec aversion au risque \\(\\eta\\).",
								"helpPosition": "bottom",
								"textSize": 16,
								"textFamily": "default",
								"textColor": "#000000"
							}
						},
						{
							"id": 9,
							"customId": "",
							"type": "number",
							"data": {
