									"customId": "",
									"type": "label",
									"data": {
										"value": "\\(X_s^{t, x, \\alpha} = x + \\int_{t}^{s}(c - \\alpha_u)du + \\frac12\\sigma \\int_{t}^{s} dW_u - \\sum_{k = N_t+1}^{N_s}Y_k\\)",
										"css": "",
										"language": false,
										"marginTop": 10,
										"labelText": "Le processus de richesse :",
										"labelPosition": "topaligned",
										"helpText": "L'assureur encaisse les primes et investit pour diminuer les sinistres subis",
										"helpPosition": "bottom",
										"textSize": 14,
										"textFamily": "default",
										"textColor": "#000000"
									}
								},
