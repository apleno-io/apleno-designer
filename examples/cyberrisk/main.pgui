									"id": "",
									"type": "label",
									"data": {
										"value": "\\(X_s^{t, x, \\alpha} = x + \\int_{t}^{s}(c - \\alpha_u)du + \\frac12\\sigma \\int_{t}^{s} dW_u - \\sum_{k = N_t+1}^{N_s}Y_k\\)",
