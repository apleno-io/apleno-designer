									"type": "label",
									"data": {
										"value": "\\(\\Lambda_s^{t, \\lambda} = \\lambda - \\int_{t}^{s}\\beta(\\Lambda_u^{t, \\lambda} - \\mu)du + \\delta \\int_{t}^{s}dN_u\\)",
